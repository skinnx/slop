{
  "name": "slop-tools",
  "private": true,
  "description": "Linux toolchain for the Cocos Creator 3.8.8 project in ../game: engine build, type-check, core tests, browser harness.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "vitest run",
    "harness": "node harness/run.mjs",
    "atlas": "node scripts/pack-atlas.mjs",
    "check": "npm run typecheck && npm test && node harness/run.mjs harness/scenarios/example.mjs",
    "drawcalls": "node harness/run.mjs harness/scenarios/stats.mjs",
    "atlas:view": "node atlas/build-view-atlases.mjs",
    "sim": "node sim/run-ts.mjs sim/main.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "esbuild": "0.25.12",
    "glsl-parser": "2.0.1",
    "glsl-tokenizer": "2.1.5",
    "js-yaml": "4.1.0",
    "playwright-core": "1.63.0",
    "pngjs": "7.0.0",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
